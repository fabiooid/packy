# Names only. Set real values as Railway variables on the connectors service, or in a local .env. Never commit them.
PORT=8790
# Shared with Packy as PACKY_CONNECTOR_TOKEN_<NAME>. Generate: openssl rand -hex 32
CONNECTOR_TOKEN=
# Shopify (read-only). Use a token, or a Dev Dashboard app's client id and secret.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Faire (brand access token from the Faire brand portal, read-only use).
FAIRE_ACCESS_TOKEN=
# Fatture in Cloud (read-only, products scope).
FATTURE_IN_CLOUD_API_KEY=
FIC_COMPANY_ID=
