# Names only. Provision real values through Railway variables or a local .env. Never commit them.
PORT=8787
PACKY_DB=data/packy.db
# Connectors (spec/connector-v1.md): name=https-address, comma separated. Packy holds no platform keys.
PACKY_CONNECTORS=
# One token per connector: PACKY_CONNECTOR_TOKEN_<NAME>, for example PACKY_CONNECTOR_TOKEN_SHOPIFY.
# Which connector provides the product list. Needed only when more than one offers products.
PACKY_PRODUCTS_FROM=
