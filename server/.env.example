# Names only. Provision real values through Railway variables or a local .env. Never commit them.
PORT=8787
PACKY_DB=data/packy.db
# Order source (read-only). Use a token, or a Dev Dashboard app's client id and secret.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# FIC catalog authority (read-only, products scope).
FATTURE_IN_CLOUD_API_KEY=
FIC_COMPANY_ID=<company-id>
